# ─────────────────────────────────────────────────────────────────────────────
# LMS Platform — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running docker compose.
# Production API_PUBLIC_URL and WEB_APP_URL MUST use HTTPS.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Public domain (set to your HTTPS domain) ─────────────────────────────────
# These are used by the API for OAuth callbacks, email links, QR codes, etc.
# Example: https://lms.yourdomain.com
API_PUBLIC_URL=https://lms.yourdomain.com
WEB_APP_URL=https://lms.yourdomain.com

# ── Ports (internal to containers — do NOT change unless you know what you're doing) ─
PORT=4000
WEB_PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Injected automatically by docker-compose; override only for external Mongo.
MONGO_URI=mongodb://mongodb:27017/edtech_lms?replicaSet=rs0

# ── Redis ─────────────────────────────────────────────────────────────────────
# Injected automatically by docker-compose; override only for external Redis.
REDIS_URL=redis://redis:6379

# ── Security & Secrets (generate strong random strings in production) ─────────
JWT_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
EMAIL_ENCRYPTION_KEY=replace-with-exactly-32-random-characters-here
STORAGE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OAUTH_STATE_SECRET=replace-with-a-distinct-32-byte-random-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (must match WEB_APP_URL in prod).
CORS_ORIGINS=https://lms.yourdomain.com

# ── Storage provider ──────────────────────────────────────────────────────────
# local  → files stored inside the api container volume (simple, no CDN)
# r2     → Cloudflare R2 (recommended for production)
STORAGE_PROVIDER=local

# Cloudflare R2 (required when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=lms-media
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_EXPIRES_IN=3600

# ── OAuth / External integrations ────────────────────────────────────────────
# Exact redirect URIs: API_PUBLIC_URL + /api/v1/integrations/connections/<provider>/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Tenant / Platform resolution ─────────────────────────────────────────────
PUBLIC_PLATFORM_DOMAIN=yourdomain.com
PUBLIC_DEFAULT_TENANT_ID=

# ── Internal worker auth ──────────────────────────────────────────────────────
INTERNAL_WORKER_SECRET=replace-with-at-least-16-random-characters
API_INTERNAL_URL=http://api:4000

# ── Finance reconciliation (optional tuning) ──────────────────────────────────
PAYMENT_RECONCILIATION_STALE_MINUTES=15
REFUND_RECONCILIATION_STALE_MINUTES=15
FINANCE_RECONCILIATION_BATCH_SIZE=25
FINANCE_RECONCILIATION_INTERVAL_MS=30000
FINANCE_RECONCILIATION_CONCURRENCY=3

# ── File size limits (bytes) ──────────────────────────────────────────────────
MAX_FILE_SIZE_IMAGE=10485760
MAX_FILE_SIZE_PDF=26214400
MAX_FILE_SIZE_AUDIO=104857600
MAX_FILE_SIZE_VIDEO=524288000

# ── Veblika Edge (set automatically by master-panel deploy orchestrator) ──────
# Do NOT set manually unless deploying standalone outside the master-panel.
# GATEWAY_ALIAS=lms-gateway
