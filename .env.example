# Environment Configuration Template
NODE_ENV=development
PORT=4000
WEB_PORT=3000
WEB_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/edtech_lms?replicaSet=rs0

# Redis Cache & Queues Configuration
REDIS_URL=redis://localhost:6379

# Security & Secrets (Use strong random strings in production)
JWT_SECRET=super-secret-jwt-key-placeholder
JWT_REFRESH_SECRET=super-secret-refresh-key-placeholder
EMAIL_ENCRYPTION_KEY=didm-lms-email-secret-key-32bytes-placeholder
STORAGE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OAUTH_STATE_SECRET=replace-with-a-distinct-32-byte-random-secret

# Phase 22 external providers (server-side only; never expose through NEXT_PUBLIC_*)
# Exact redirect URIs are API_PUBLIC_URL +:
# /api/v1/integrations/connections/google_classroom/callback
# /api/v1/integrations/connections/google_meet/callback
# /api/v1/integrations/connections/zoom/callback
# /api/v1/integrations/connections/microsoft_teams/callback
# Production API_PUBLIC_URL and WEB_APP_URL must use HTTPS.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Provider Configuration (local vs r2)
STORAGE_PROVIDER=local

# Cloudflare R2 Storage Credentials (Required when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=didm-lms-media
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_EXPIRES_IN=3600

# Public Tenant Resolution Runtime Configuration (STEP 5A)
PUBLIC_PLATFORM_DOMAIN=platform.com
PUBLIC_DEFAULT_TENANT_ID=

# Internal finance worker and reconciliation
INTERNAL_WORKER_SECRET=replace-with-at-least-16-random-characters
API_INTERNAL_URL=http://localhost:4000
PAYMENT_RECONCILIATION_STALE_MINUTES=15
REFUND_RECONCILIATION_STALE_MINUTES=15
FINANCE_RECONCILIATION_BATCH_SIZE=25
FINANCE_RECONCILIATION_INTERVAL_MS=30000
FINANCE_RECONCILIATION_CONCURRENCY=3
