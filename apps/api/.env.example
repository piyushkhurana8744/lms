PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/edtech_lms?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_SECRET=super-secret-jwt-key-placeholder
JWT_REFRESH_SECRET=super-secret-refresh-key-placeholder
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
STORAGE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OAUTH_STATE_SECRET=replace-with-a-distinct-32-byte-random-secret

# Phase 22 external providers (server-side only)
# Production API_PUBLIC_URL and WEB_APP_URL must use HTTPS. Register callbacks
# exactly as documented in docs/provider-integrations-setup.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ==========================================
# STORAGE CONFIGURATION
# ==========================================
# LOCAL DEVELOPMENT: STORAGE_PROVIDER=local
# CLOUDFLARE R2:    STORAGE_PROVIDER=r2
STORAGE_PROVIDER=local

# Cloudflare R2 Credentials (Required when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional Custom/Public Domain (e.g., https://media.yourdomain.com)
R2_PUBLIC_BASE_URL=

# Signed URL Expiry in Seconds (Default: 3600)
R2_SIGNED_URL_EXPIRES_IN=3600

# ==========================================
# FILE SIZE LIMITS (BYTES)
# ==========================================
MAX_FILE_SIZE_IMAGE=10485760
MAX_FILE_SIZE_PDF=26214400
MAX_FILE_SIZE_AUDIO=104857600
MAX_FILE_SIZE_VIDEO=524288000

# Shared only with the background worker
INTERNAL_WORKER_SECRET=replace-with-at-least-16-random-characters
